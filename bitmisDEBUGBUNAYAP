        static void Parça_Oluştur(int harfSayısı, int parçaIndex)
        {
            ParcaBlokSayilari[parçaIndex] = harfSayısı;

            // döngülü işlemler için matrisi sıfırladık
            for (int r = 0; r < 5; r++) for (int c = 0; c < 5; c++) ParcaMatrisi[0, parçaIndex, r, c] = 0;

            // iki farklı dizide kayıt altına almış olduk
            int[] harfSatırları = new int[harfSayısı];
            int[] harfSütunları = new int[harfSayısı];
            int sayaç = 0;

            int ilkHarfSatırı = zar.Next(0, 5);
            int ilkHarfSütunu = zar.Next(0, 5);

            // yayılma çizimi için ilk noktayı kayıt ettik
            harfSatırları[sayaç] = ilkHarfSatırı;
            harfSütunları[sayaç] = ilkHarfSütunu;
            ParcaMatrisi[0, parçaIndex, ilkHarfSatırı, ilkHarfSütunu] = 1; // Dolu parça == 1
            sayaç++;

            // yayılım işlemi
            for (int i = 1; i < harfSayısı; i++)
            {
                int rastgeleHarfSeç = zar.Next(0, sayaç);
                int yön = zar.Next(1, 5); // random yönde yayılım ( 1: yukarı, 2: sağ, 3: aşağı, 4: sol)

                int yeniSatir = harfSatırları[rastgeleHarfSeç];
                int yeniSutun = harfSütunları[rastgeleHarfSeç];

                if (yön == 1 && harfSatırları[rastgeleHarfSeç] != 0 && ParcaMatrisi[0, parçaIndex, harfSatırları[rastgeleHarfSeç] - 1, harfSütunları[rastgeleHarfSeç]] != 1)
                {
                    harfSatırları[sayaç] = harfSatırları[rastgeleHarfSeç] - 1;
                    harfSütunları[sayaç] = harfSütunları[rastgeleHarfSeç];
                    ParcaMatrisi[0, parçaIndex, harfSatırları[sayaç], harfSütunları[sayaç]] = 1; // matrixi dolu == 1 yaptık
                    sayaç++;
                }
                else if (yön == 2 && harfSütunları[rastgeleHarfSeç] != 4 && ParcaMatrisi[0, parçaIndex, harfSatırları[rastgeleHarfSeç], harfSütunları[rastgeleHarfSeç] + 1] != 1)
                {
                    harfSütunları[sayaç] = harfSütunları[rastgeleHarfSeç] + 1;
                    harfSatırları[sayaç] = harfSatırları[rastgeleHarfSeç];
                    ParcaMatrisi[0, parçaIndex, harfSatırları[sayaç], harfSütunları[sayaç]] = 1;
                    sayaç++;
                }
                else if (yön == 3 && harfSatırları[rastgeleHarfSeç] != 4 && ParcaMatrisi[0, parçaIndex, harfSatırları[rastgeleHarfSeç] + 1, harfSütunları[rastgeleHarfSeç]] != 1)
                {
                    harfSatırları[sayaç] = harfSatırları[rastgeleHarfSeç] + 1;
                    harfSütunları[sayaç] = harfSütunları[rastgeleHarfSeç];
                    ParcaMatrisi[0, parçaIndex, harfSatırları[sayaç], harfSütunları[sayaç]] = 1;
                    sayaç++;
                }
                else if (yön == 4 && harfSütunları[rastgeleHarfSeç] != 0 && ParcaMatrisi[0, parçaIndex, harfSatırları[rastgeleHarfSeç], harfSütunları[rastgeleHarfSeç] - 1] != 1)
                {
                    harfSütunları[sayaç] = harfSütunları[rastgeleHarfSeç] - 1;
                    harfSatırları[sayaç] = harfSatırları[rastgeleHarfSeç];
                    ParcaMatrisi[0, parçaIndex, harfSatırları[sayaç], harfSütunları[sayaç]] = 1;
                    sayaç++;
                }
                else
                {
                    i--; // geçersiz bir hareket yapıldıysa, döngü sayacınının korunmasını sağladık
                }
            } // kontrol yapabilmek için her parçayı sola yasladık
            VaryasyonuSolaYasla(0, parçaIndex);
        }
