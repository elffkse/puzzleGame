        static void VaryasyonlariOlustur(int parçaIndex)
        {
            MatrisiAynala(parçaIndex, 0, 4);

            for (int i = 0; i < 3; i++)
            {
                MatrisiDondur(parçaIndex, 0 + i, 0 + i + 1);

                MatrisiDondur(parçaIndex, 4 + i, 4 + i + 1);
            }

            // kontrol yapabilmek için hizaladık
            for (int v = 1; v < 8; v++) VaryasyonuSolaYasla(v, parçaIndex);
        }

        static void MatrisiDondur(int pIndex, int src, int dest)
        {
            for (int r = 0; r < 5; r++) // r = row , c = column
                for (int c = 0; c < 5; c++)
                {
                    ParcaMatrisi[dest, pIndex, c, 4 - r] = 0; // döndürme işleminde satırlar sütun konumunda olmakta. sütunlar ise ters satır konumunda
                    if (ParcaMatrisi[src, pIndex, r, c] == 1) // src veriyi hangi yerden aldığımız
                        ParcaMatrisi[dest, pIndex, c, 4 - r] = 1; // dest veriyi hangi yere kaydettiğimiz
                }
        }

        static void MatrisiAynala(int pIndex, int src, int dest)
        {
            for (int r = 0; r < 5; r++)
                for (int c = 0; c < 5; c++)
                    ParcaMatrisi[dest, pIndex, r, 4 - c] = ParcaMatrisi[src, pIndex, r, c];
        }

        static void VaryasyonuSolaYasla(int pozisyon, int pIndex)
        {
            int minRow = 5, minC = 5;
            // her kareyi gezip en küçük dolu satır ve sütunu bulduk. konumu 0-0 yaparak sola kaydırdık
            for (int r = 0; r < 5; r++)
                for (int c = 0; c < 5; c++)
                    if (ParcaMatrisi[pozisyon, pIndex, r, c] == 1)
                    {
                        if (r < minRow) minRow = r;
                        if (c < minC) minC = c;
                    }
            // zaten en sola yaslı ise işlem yapma
            if (minRow == 0 && minC == 0) return;

            int[,] temp = new int[5, 5];
            for (int r = 0; r < 5; r++)
                for (int c = 0; c < 5; c++)
                    if (ParcaMatrisi[pozisyon, pIndex, r, c] == 1)
                        temp[r - minRow, c - minC] = 1;
            // main matrixi sola kaymış haliyle güncelledik
            for (int r = 0; r < 5; r++)
                for (int c = 0; c < 5; c++)
                    ParcaMatrisi[pozisyon, pIndex, r, c] = temp[r, c];
        }

        //güncelden başlayıp parçanın öncekilerle kopya olup olmadığını kontrol ettik
        static bool KopyaVarMi(int current)
        {
            for (int previous = 0; previous < current; previous++)
            {
                // blok sayıları eşit değilse kopya olamaz.
                if (ParcaBlokSayilari[current] != ParcaBlokSayilari[previous])
                    continue;

                // mevcut parçanın 8 varyasyonunu kontrol et
                for (int v_current = 0; v_current < 8; v_current++)
                {
                    // önceki parçanın 8 varyasyonunu kontrol et
                    for (int v_previous = 0; v_previous < 8; v_previous++)
                    {

                        if (MatrislerEsitMi(v_current, current, v_previous, previous))
                            return true;
                    }
                }
            }
            return false;
        }

        static bool MatrislerEsitMi(int varyasyon1, int parçaidx1, int varyasyon2, int parçaidx2)
        {
            for (int r = 0; r < 5; r++)
                for (int c = 0; c < 5; c++)
                    if (ParcaMatrisi[varyasyon1, parçaidx1, r, c] != ParcaMatrisi[varyasyon2, parçaidx2, r, c])
                        return false;
            return true;
        }

        // puzzle oluşturma fonksiyonu ve parçaları alana yerleştirme
        static bool PuzzleOlustur(int parcaSayisi)
        {
            // alanını sıfırla sorun çıkmaması için
            for (int r = 0; r < 20; r++)
                for (int c = 0; c < 30; c++)
                    PuzzleAlani[r, c] = 0;

            // ilk parçayı merkeze yakın yerleştir ( merkezden dağılımı sağlamak için )
            int merkezSatir = 10;
            int merkezSutun = 15;

            // ilk koyulacak parça için rastgele varyasyon seç
            int varyasyon = zar.Next(0, 8);
            ParcaKullanilanVaryasyon[0] = varyasyon;

            if (!ParcayiYerlestir(0, varyasyon, merkezSatir, merkezSutun))
            {
                return false;
            }

            // diğer parçaları sırayla yerleştir
            for (int p = 1; p < parcaSayisi; p++)
            {
                bool yerlesti = false;
                int denemeSayisi = 0;
                int maxDeneme = 500; // her parça için maksimum deneme sayısı ( sonsuz döngüye girmemesi için )

                while (!yerlesti && denemeSayisi < maxDeneme)
                {
                    // rastgele varyasyon seç
                    varyasyon = zar.Next(0, 8);

                    int[] konum = MerkeziKonumBul(p, varyasyon);

                    if (konum != null)
                    {
                        int denemeSatir = konum[0];
                        int denemeSutun = konum[1];

                        // parçayı yerleştirmeyi dene
                        if (ParcayiYerlestir(p, varyasyon, denemeSatir, denemeSutun))
                        {
                            yerlesti = true;
                            ParcaKullanilanVaryasyon[p] = varyasyon;
                        }
                    }
                    denemeSayisi++;
                }

                if (!yerlesti)
                {
                    return false; // parça yerleştirilemedi
                }
            }

            return true;
        }

        // parçayı belirtilen konuma yerleştirmeyi dene
        static bool ParcayiYerlestir(int parcaIndex, int varyasyon, int baslangicSatir, int baslangicSutun)
        {
            // yerleştirilebilir mi kontrol et
            for (int r = 0; r < 5; r++)
            {
                for (int c = 0; c < 5; c++)
                {
                    if (ParcaMatrisi[varyasyon, parcaIndex, r, c] == 1)
                    {
                        int hedefSatir = baslangicSatir + r;
                        int hedefSutun = baslangicSutun + c;

                        // sınır kontrolü
                        if (hedefSatir < 0 || hedefSatir >= 20 || hedefSutun < 0 || hedefSutun >= 30)
                            return false;

                        // çakışma kontrolü
                        if (PuzzleAlani[hedefSatir, hedefSutun] != 0)
                            return false;
                    }
                }
            }

            // ilk parça değilse komşuluk kontrolü yap ( bağlantı olmalı )
            if (parcaIndex > 0)
            {
                bool komsulukVar = false;
                for (int r = 0; r < 5; r++)
                {
                    for (int c = 0; c < 5; c++)
                    {
                        if (ParcaMatrisi[varyasyon, parcaIndex, r, c] == 1)
                        {
                            int hedefSatir = baslangicSatir + r;
                            int hedefSutun = baslangicSutun + c;

                            // 4 yönde komşu var mı kontrol et
                            if ((hedefSatir > 0 && PuzzleAlani[hedefSatir - 1, hedefSutun] != 0) ||
                                (hedefSatir < 19 && PuzzleAlani[hedefSatir + 1, hedefSutun] != 0) ||
                                (hedefSutun > 0 && PuzzleAlani[hedefSatir, hedefSutun - 1] != 0) ||
                                (hedefSutun < 29 && PuzzleAlani[hedefSatir, hedefSutun + 1] != 0))
                            {
                                komsulukVar = true;
                                break;
                            }
                        }
                    }
                    if (komsulukVar) break;
                }

                if (!komsulukVar)
                    return false;
            }

            // yerleştir ( parça numarasını +1 olarak kaydet 0 boş demek)
            for (int r = 0; r < 5; r++)
            {
                for (int c = 0; c < 5; c++)
                {
                    if (ParcaMatrisi[varyasyon, parcaIndex, r, c] == 1)
                    {
                        int hedefSatir = baslangicSatir + r;
                        int hedefSutun = baslangicSutun + c;
                        PuzzleAlani[hedefSatir, hedefSutun] = parcaIndex + 1;
                    }
                }
            }

            // konumunu kaydet
            ParcaPuzzleSatir[parcaIndex] = baslangicSatir;
            ParcaPuzzleSutun[parcaIndex] = baslangicSutun;

            return true;
        }

