        // puzzleın merkeze ve her yöne yayılmasını sağlayan fonksiyon
        static int[] MerkeziKonumBul(int parcaIndex, int varyasyon)
        {
            // puzzledeki dolu karelerin listesini al (( alandaki yerleri ))
            int[] doluSatirlar = new int[600];
            int[] doluSutunlar = new int[600];
            int doluSayisi = 0;

            for (int r = 0; r < 20; r++)
                for (int c = 0; c < 30; c++)
                    if (PuzzleAlani[r, c] != 0)
                    {
                        doluSatirlar[doluSayisi] = r;
                        doluSutunlar[doluSayisi] = c;
                        doluSayisi++;
                    }

            if (doluSayisi == 0) return null;

            // parçanın içindeki dolu blokların listesini al (( parçalardaki yerleri ))
            int[] parcaSatirlar = new int[25];
            int[] parcaSutunlar = new int[25];
            int parcaDoluSayisi = 0;

            for (int r = 0; r < 5; r++)
                for (int c = 0; c < 5; c++)
                    if (ParcaMatrisi[varyasyon, parcaIndex, r, c] == 1)
                    {
                        parcaSatirlar[parcaDoluSayisi] = r;
                        parcaSutunlar[parcaDoluSayisi] = c;
                        parcaDoluSayisi++;
                    }

            // rastgele denemeler yap
            int denemeLimiti = 100;
            for (int i = 0; i < denemeLimiti; i++)
            {
                // puzzleden rastgele bir referans kare seç
                int randPuzzleIdx = zar.Next(0, doluSayisi); // rastgele puzzle sırası
                int refR = doluSatirlar[randPuzzleIdx];
                int refC = doluSutunlar[randPuzzleIdx];

                // parçadan rastgele bir referans blok seç ( Bu blok temas edecek )
                int randParcaIdx = zar.Next(0, parcaDoluSayisi);
                int pR = parcaSatirlar[randParcaIdx];
                int pC = parcaSutunlar[randParcaIdx];

                // rastgele bir yön seç ( temas edilecek yönü)
                int yon = zar.Next(0, 4);
                // / 0: Yukarı, 1: Sağ, 2: Aşağı, 3: Sol /

                int hedefR = refR;
                int hedefC = refC;

                if (yon == 0) hedefR--;      // yukarısına
                else if (yon == 1) hedefC++; // sağına
                else if (yon == 2) hedefR++; // aşağısına
                else hedefC--;               // soluna

                int sonucR = hedefR - pR;
                int sonucC = hedefC - pC;

                // elimizdeki 5x5 matrisin alan sınırlarını kontrol ediyor boş kısımları dışarıda kalabiliyor ama dolu kısımlar mutlaka içeride kalmış oluyor
                if (sonucR >= 0 && sonucR <= 15 && sonucC >= 0 && sonucC <= 25)
                {
                    return new int[] { sonucR, sonucC };
                }
            }
            return null;
        }

        static double calculate_regularity(int[,] board)
        {
            int total_squares = 0; // kare sayısı
            int total_perimeter = 0; // çevre
            int row = board.GetLength(0); // satır sayısı
            int column = board.GetLength(1); // sütun sayısı

            for (int i = 0; i < row; i++)
            {
                for (int j = 0; j < column; j++)
                {
                    if (board[i, j] != 0) // kare sayısı için
                    {
                        total_squares++;

                        if (i == 0 || board[i - 1, j] == 0) // yukarı için
                            total_perimeter++;
                        if (i == row - 1 || board[i + 1, j] == 0) // aşağı için
                            total_perimeter++;
                        if (j == 0 || board[i, j - 1] == 0) // sol için
                            total_perimeter++;
                        if (j == column - 1 || board[i, j + 1] == 0)  // sağ için
                            total_perimeter++;
                    }
                }
            }
            if (total_perimeter == 0)
                return 0; // payda sıfır olmasın diye

            double dividedBy4 = total_perimeter / 4.0;
            double denominator = Math.Pow(dividedBy4, 2);

            return total_squares / denominator;
        }

        static bool hareket(int totalPieces)
        {
            // Save the original puzzle layout
            for (int r = 0; r < 20; r++)
                for (int c = 0; c < 30; c++)
                    OriginalPuzzle[r, c] = PuzzleAlani[r, c];

            // Clear PuzzleAlani for user placements
            for (int r = 0; r < 20; r++)
                for (int c = 0; c < 30; c++)
                    PuzzleAlani[r, c] = 0;

            // başlangıç konumu
            int imlecX = 10;
            int imlecY = 10;

            // varsayılan A olarak başlıyor
            int secilenParcaIndeksi = 0;

            Console.CursorVisible = false;
            ConsoleKeyInfo basilanTus;

            // Tüm parçaları kullanılabilir yap
            for (int i = 0; i < totalPieces; i++)
            {
                ParcaKullanildi[i] = false;
            }

            // döngüye girmeden seçili parçayı çiz
            int mevcutVaryasyon = ParcaKullanilanVaryasyon[secilenParcaIndeksi];
            for (int r = 0; r < 5; r++)
            {
                for (int c = 0; c < 5; c++)
                {
                    if (ParcaMatrisi[mevcutVaryasyon, secilenParcaIndeksi, r, c] == 1)
                    {
                        karakterCizme(imlecX + c, imlecY + r, harfListesi[secilenParcaIndeksi]);
                    }
                }
            }

            while (true)
            {
                if (AllPiecesPlaced(totalPieces))
                {
                    Console.SetCursorPosition(0, 26);
                    Console.ForegroundColor = ConsoleColor.Green;
                    Console.Write("All pieces placed! Press ENTER to finish, Q to continue editing");
                    Console.ResetColor();

                    ConsoleKeyInfo finishKey = Console.ReadKey(true);
                    if (finishKey.Key == ConsoleKey.Enter)
                    {
                        return true;
                    }
                    else if (finishKey.Key == ConsoleKey.Q)
                    {
                        Console.SetCursorPosition(0, 26);
                        Console.Write("                                                                    ");
                    }
                }

                basilanTus = Console.ReadKey(true);

                // Eski durumu kaydet
                int eskiX = imlecX;
                int eskiY = imlecY;
                int eskiParcaIndex = secilenParcaIndeksi;
                int eskiVaryasyonIndex = ParcaKullanilanVaryasyon[secilenParcaIndeksi];

                // parçanın seçimi
                // basılan tuş kontrolü
                for (int i = 0; i < totalPieces; i++)
                {
                    // eşleşme kontrolü
                    if (basilanTus.Key.ToString() == harfListesi[i].ToString())
                    {
                        secilenParcaIndeksi = i;
                    }
                }

                // hareket ve dönüşümler
                switch (basilanTus.Key)
                {
                    // yön tuşlarıyla hareket
                    case ConsoleKey.RightArrow:
                        if (imlecX < 26) imlecX++;
                        break;
                    case ConsoleKey.LeftArrow:
                        if (imlecX > 2) imlecX--;
                        break;
                    case ConsoleKey.UpArrow:
                        if (imlecY > 2) imlecY--;
                        break;
                    case ConsoleKey.DownArrow:
                        if (imlecY < 16) imlecY++;
                        break;

                    // döndürme işlemi z
                    case ConsoleKey.Z:
                        int eskiVaryasyon = ParcaKullanilanVaryasyon[secilenParcaIndeksi];

                        // Normal 0-3 : 0>1>2>3>0
                        // Reverse 4-7 : 4>5>6>7>4
                        if (eskiVaryasyon < 4)
                            ParcaKullanilanVaryasyon[secilenParcaIndeksi] = (eskiVaryasyon + 1) % 4;
                        else
