                            Console.Clear();
                            Console.ForegroundColor = ConsoleColor.Yellow;
                            Console.WriteLine($"Game Over! Final Score: {totalScore}");
                            Console.ResetColor();
                            Console.ReadKey();
                            break;
                        }

                        Console.Clear();
                        UI(UIWidth, UIHeight);

                        int tempKonumSatir = 1;
                        int tempIndex = 0;
                        for (int i = 0; i < 4; i++, tempKonumSatir += 7)
                        {
                            if (tempIndex >= toplamParcaSayisi) break;
                            int tempKonumSutun = UIWidth + 5;
                            for (int j = 0; j < 5; j++)
                            {
                                if (tempIndex >= toplamParcaSayisi) break;
                                ParcayiCiz(tempIndex, tempKonumSutun, tempKonumSatir, harfListesi[tempIndex]);
                                tempIndex++;
                                tempKonumSutun += 10;
                            }
                        }
                        PuzzleCizUIIcinde(UIWidth, UIHeight, harfListesi);
                    }

                    Console.Write("Play new game? (Y/N): ");
                    ConsoleKeyInfo playAgain = Console.ReadKey(true);
                    if (playAgain.Key != ConsoleKey.Y)
                    {
                        break;
                    }
                    totalScore = 0;
                    currentRound = 0;

                }
            }
        }
    }
